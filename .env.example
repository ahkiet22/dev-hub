# Database (PostgreSQL, tables reside in schema "dev-hub")
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=admin
DATABASE_PASSWORD=admin
DATABASE_NAME=
DATABASE_SSLMODE=disable
DATABASE_SCHEMA=dev-hub

# Optional single connection URL override (e.g. Vercel / Neon / Supabase)
# DATABASE_URL=

# App URL (used for Origin/CSRF verification in production)
APP_URL=http://localhost:3000

# Initial Admin Seed (only used by scripts/seed.ts)
SEED_ADMIN_EMAIL=admin@devhub.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-in-local-env
SEED_ADMIN_FULL_NAME=Dev Hub Admin

# Health Monitoring & Security
CRON_SECRET=replace-with-random-secret
TRUSTED_PRIVATE_NETWORKS=
HEALTH_RETENTION_DAYS=30

# Microfrontend Security
ALLOWED_REMOTE_ORIGINS=http://localhost:3001
