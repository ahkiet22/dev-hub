// Dev Hub — Complete Database Schema (dbdiagram.io compatible)
// PostgreSQL Schema: "dev-hub"
// Note: No ORM; managed via raw SQL migrations targeting schema "dev-hub".

Project dev_hub {
  database_type: 'PostgreSQL'
  Note: 'Personal Developer Hub. All tables reside in PostgreSQL schema "dev-hub".'
}

Enum "dev-hub".project_status {
  ACTIVE
  INACTIVE
  ARCHIVED
}

Enum "dev-hub".health_status {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNREACHABLE
  INVALID_RESPONSE
}

Enum "dev-hub".frontend_integration_type {
  MODULE_FEDERATION
  IFRAME
  EXTERNAL
}

Table "dev-hub".users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null]
  username varchar(64) [not null]
  password_hash text [not null]
  full_name varchar(120)
  avatar_url text
  is_active boolean [not null, default: true]
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    email [unique, name: 'uq_users_email_active', note: 'Partial unique index: WHERE deleted_at IS NULL']
    username [unique, name: 'uq_users_username_active', note: 'Partial unique index: WHERE deleted_at IS NULL']
  }
}

Table "dev-hub".user_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > "dev-hub".users.id]
  token_hash char(64) [unique, not null, note: 'SHA-256 hex digest of 32-byte opaque token']
  ip_address inet
  user_agent text
  expires_at timestamptz [not null]
  last_used_at timestamptz
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: 'idx_user_sessions_user_id']
    token_hash [unique, name: 'uq_user_sessions_token_hash']
    expires_at [name: 'idx_user_sessions_expires_at']
  }
}

Table "dev-hub".projects {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > "dev-hub".users.id]
  code varchar(64) [not null]
  name varchar(120) [not null]
  description text
  icon_url text
  status "dev-hub".project_status [not null, default: 'ACTIVE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    (user_id, code) [unique, name: 'uq_projects_user_code_active', note: 'Partial unique index: WHERE deleted_at IS NULL']
    (user_id, status) [name: 'idx_projects_user_status', note: 'Partial index: WHERE deleted_at IS NULL']
  }
}

Table "dev-hub".deployment_platforms {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(64) [unique, not null]
  name varchar(120) [not null]
  description text
  website_url text
  console_url text
  icon_url text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table "dev-hub".project_backends {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [not null, ref: > "dev-hub".projects.id]
  deployment_platform_id uuid [ref: > "dev-hub".deployment_platforms.id]
  name varchar(120) [not null]
  description text
  repository_url text
  base_url text
  health_url text [not null]
  deployment_console_url text
  health_status "dev-hub".health_status [not null, default: 'UNKNOWN']
  check_interval_seconds integer [not null, default: 60, note: 'CHECK (check_interval_seconds BETWEEN 10 AND 86400)']
  timeout_ms integer [not null, default: 5000, note: 'CHECK (timeout_ms BETWEEN 500 AND 30000)']
  last_checked_at timestamptz
  last_healthy_at timestamptz
  response_time_ms integer
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    project_id [name: 'idx_project_backends_project_id', note: 'WHERE deleted_at IS NULL']
    (is_active, last_checked_at) [name: 'idx_project_backends_due_checks', note: 'WHERE deleted_at IS NULL AND is_active = true']
  }
}

Table "dev-hub".backend_health_checks {
  id uuid [pk, default: `gen_random_uuid()`]
  backend_id uuid [not null, ref: > "dev-hub".project_backends.id]
  status "dev-hub".health_status [not null]
  http_status_code integer
  response_time_ms integer
  response_body jsonb [note: 'Sanitized, size-bounded health payload only']
  error_message text
  checked_at timestamptz [not null, default: `now()`]

  Indexes {
    (backend_id, checked_at) [name: 'idx_backend_health_checks_backend_checked']
    checked_at [name: 'idx_backend_health_checks_checked_at', note: 'Supports 30-day retention cleanup']
  }
}

Table "dev-hub".project_frontends {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [not null, ref: > "dev-hub".projects.id]
  deployment_platform_id uuid [ref: > "dev-hub".deployment_platforms.id]
  name varchar(120) [not null]
  slug varchar(80) [not null]
  description text
  repository_url text
  application_url text
  deployment_console_url text
  integration_type "dev-hub".frontend_integration_type [not null, default: 'MODULE_FEDERATION']
  entry_url text
  remote_name varchar(120)
  exposed_module varchar(120)
  icon_url text
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    (project_id, slug) [unique, name: 'uq_project_frontends_project_slug_active', note: 'Partial unique index: WHERE deleted_at IS NULL']
    (project_id, sort_order) [name: 'idx_project_frontends_project_sort', note: 'WHERE deleted_at IS NULL']
  }
}

Table "dev-hub".ai_providers {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(64) [unique, not null]
  name varchar(120) [not null]
  website_url text [not null]
  logo_url text
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table "dev-hub".ai_accounts {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > "dev-hub".users.id]
  provider_id uuid [not null, ref: > "dev-hub".ai_providers.id]
  email varchar(255) [not null, note: 'Normalized lowercase trimmed email']
  note text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, provider_id, email) [unique, name: 'uq_ai_accounts_user_provider_email']
    (user_id, provider_id) [name: 'idx_ai_accounts_user_provider']
  }
}
